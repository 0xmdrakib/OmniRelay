# Copy to .env and configure every value locally. Do not commit .env.
# Neon is mandatory: pooled URL for runtime, direct URL for schema migration.
# Configure both safely with deploy/configure-neon.ps1.
DATABASE_URL=
DATABASE_MIGRATION_URL=
DATABASE_POOL_MAX=
DATABASE_POOL_IDLE_TIMEOUT_MS=
DATABASE_CONNECTION_TIMEOUT_MS=
DATABASE_QUERY_TIMEOUT_MS=
DATABASE_STATEMENT_TIMEOUT_MS=
DATABASE_POOL_MAX_USES=
HTTP_REQUEST_TIMEOUT_MS=
MAX_IN_FLIGHT_REQUESTS=
HTTP_MAX_CONNECTIONS=
WEBSOCKET_MAX_CONNECTIONS=
PUSH_MAX_CONCURRENCY=
PUSH_MAX_QUEUED=
SHUTDOWN_TIMEOUT_MS=
CLEANUP_INTERVAL_SECONDS=
CLEANUP_BATCH_SIZE=
CALL_SIGNAL_TTL_SECONDS=
CALL_MAX_FUTURE_SKEW_SECONDS=
CALL_ACTIVE_LEASE_SECONDS=
MAX_REGISTRATION_CHALLENGES_PER_DEVICE=
MAX_REGISTRATION_CHALLENGES_PER_ACCOUNT=
MAX_MAILBOX_MESSAGES=
MAX_PENDING_MESSAGES_PER_PAIR=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TURN_SHARED_SECRET=
TURN_REALM=
PUBLIC_HOST=
LIVEKIT_PUBLIC_URL=
BACKEND_PORT=
BACKEND_BIND_ADDRESS=
LIVEKIT_HTTP_BIND_ADDRESS=
TRUST_PROXY=
RELAY_DOMAIN=
LIVEKIT_DOMAIN=

# Required for Google account verification and FCM wake-ups. Prefer mounting a
# service-account file through compose.firebase.yaml; the JSON env is retained
# only for hosts whose secret manager injects values directly.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
