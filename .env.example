# Copy to .env and replace every CHANGE_ME value. Do not commit .env.
# Neon is mandatory: pooled URL for runtime, direct URL for schema migration.
# Configure both safely with deploy/configure-neon.ps1.
DATABASE_URL=
DATABASE_MIGRATION_URL=
DATABASE_POOL_MAX=4
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=12000
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_POOL_MAX_USES=5000
HTTP_REQUEST_TIMEOUT_MS=15000
MAX_IN_FLIGHT_REQUESTS=64
HTTP_MAX_CONNECTIONS=768
WEBSOCKET_MAX_CONNECTIONS=512
PUSH_MAX_CONCURRENCY=4
PUSH_MAX_QUEUED=256
SHUTDOWN_TIMEOUT_MS=25000
CLEANUP_INTERVAL_SECONDS=900
CLEANUP_BATCH_SIZE=500
CALL_SIGNAL_TTL_SECONDS=60
CALL_MAX_FUTURE_SKEW_SECONDS=15
CALL_ACTIVE_LEASE_SECONDS=120
MAX_REGISTRATION_CHALLENGES_PER_DEVICE=4
MAX_REGISTRATION_CHALLENGES_PER_ACCOUNT=16
MAX_MAILBOX_MESSAGES=10000
MAX_PENDING_MESSAGES_PER_PAIR=100
LIVEKIT_API_KEY=omnirelay
LIVEKIT_API_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
TURN_SHARED_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
TURN_REALM=turn.example.com
PUBLIC_HOST=203.0.113.10
LIVEKIT_PUBLIC_URL=ws://203.0.113.10:7880
BACKEND_PORT=8080
BACKEND_BIND_ADDRESS=127.0.0.1
LIVEKIT_HTTP_BIND_ADDRESS=127.0.0.1
TRUST_PROXY=true
RELAY_DOMAIN=relay.example.com
LIVEKIT_DOMAIN=livekit.example.com

# Required for Google account verification and FCM wake-ups. Prefer mounting a
# service-account file through compose.firebase.yaml; the JSON env is retained
# only for hosts whose secret manager injects values directly.
FIREBASE_PROJECT_ID=omnirelay-a3f00
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
