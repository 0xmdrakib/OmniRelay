{
  "name": "omnirelay-backend",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/server.js",
    "test": "tsx --test test/**/*.test.ts",
    "test:unit": "tsx --test test/identity.test.ts test/protocol.test.ts",
    "test:integration": "tsx --test test/relay.integration.test.ts",
    "audit": "pnpm audit --prod --audit-level=high"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "fastify": "5.12.1",
    "firebase-admin": "14.3.0",
    "livekit-server-sdk": "2.18.0",
    "pg": "8.23.0",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
