{
  "name": "omnirelay-showcase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "audit": "pnpm audit --audit-level=low --ignore-registry-errors",
    "verify": "pnpm build && node scripts/verify-build.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
